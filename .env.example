# Local Development Configuration
# Copy this file to .env and customize if needed
# .env is git-ignored to prevent committing local secrets/overrides
#
# Note on MongoDB URLs:
# - For npm run dev (local host): use mongodb://mongoadmin:secret@localhost:27017/?authSource=admin
# - For docker compose with MongoDB (container DNS): use mongodb://mongoadmin:secret@db:27017/?authSource=admin
# - The Cosmos DB Emulator compose override supplies its own MONGO_URL

# Node environment
NODE_ENV=development

# Server configuration
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
# When not set, it defaults to PUBLIC_URL
# OIDC_ISSUER=http://localhost:3000

# OIDC clients (JSON array). Each client must have client_id, client_secret, redirect_uris.
OIDC_CLIENTS='[{"client_id":"foo","client_secret":"bar","redirect_uris":["http://localhost:3001/cb"], "post_logout_redirect_uris": ["http://localhost:3001/logout"]}]'

# Token signing key (base64-encoded PKCS#8 PEM, RSA). Omit for a generated
# ephemeral key - dev-only, tokens won't survive a restart.
# SIGNING_KEY=

# Database
MONGO_URL=mongodb://mongoadmin:secret@db:27017/?authSource=admin
MONGO_DB_NAME=cidm-stub
MONGO_TIMEOUT=5000

# Startup seed file: path to a JSON array of account documents, upserted (by sub) into the
# accounts collection at startup. Existing accounts are left untouched. Set by default in
# docker-compose.yaml, pointing at data/accounts.development.json.
# SEED_FILE_PATH=

# Logging (pino levels: trace, debug, info, warn, error, fatal)
# When not set, they both default to 'info' when NODE_ENV=production, 'debug' otherwise.
# LOG_LEVEL=
# OIDC_LOG_LEVEL=

# Session/token lifetimes (seconds). Defaults already match the real Defra CIDM Azure AD B2C
# policy's configured session and token behavior, so these normally don't need to be set -
# they're exposed only for convenience if a specific test scenario needs different values.
# SESSION_TTL_SECONDS=1800
# ID_TOKEN_TTL_SECONDS=1200
# ACCESS_TOKEN_TTL_SECONDS=1200
# REFRESH_TOKEN_TTL_SECONDS=86400
# REFRESH_TOKEN_ROLLING_TTL_SECONDS=86400
