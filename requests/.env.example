# Values for the REST Client requests in this folder. Not read by the application.
# Copy to requests/.env (gitignored) and change locally as needed.

BASE_URL=http://localhost:3000

# Must match the ADMIN_API_KEY of the running stub.
ADMIN_API_KEY=local-development-admin-key

# Sample account created and managed by admin.http.
ACCOUNT_SUB=11111111-1111-4111-8111-111111111111
ACCOUNT_EMAIL=alice.admin-api@example.test
