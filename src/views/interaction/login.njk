{% extends "layouts/default.njk" %}
{% from "components/error-summary/macro.njk" import govukErrorSummary %}
{% from "components/input/macro.njk" import govukInput %}
{% from "components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if error %}
        {{ govukErrorSummary({
          titleText: 'There is a problem',
          errorList: [{ text: error, href: '#username' }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">Sign in</h1>

      <form method="post" action="/auth/interaction/{{ uid }}/login" novalidate>
        {{ govukInput({
          label: { text: 'Email address or CRN' },
          id: 'username',
          name: 'username',
          errorMessage: { text: error } if error else undefined
        }) }}

        {{ govukButton({ text: 'Sign in' }) }}
      </form>
    </div>
  </div>
{% endblock %}
