{% from "components/header/macro.njk" import govukHeader %}
{% from "components/footer/macro.njk" import govukFooter %}
{% from "components/skip-link/macro.njk" import govukSkipLink %}

<!DOCTYPE html>
<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title>{% if pageTitle %}{{ pageTitle }} - {% endif %}Defra CIDM stub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b0c0c">
    <link rel="stylesheet" href="/assets/stylesheets/application.css">
  </head>
  <body class="govuk-template__body">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>

    {{ govukSkipLink({ href: '#main-content', text: 'Skip to main content' }) }}

    {{ govukHeader({
      homepageUrl: '/',
      serviceName: 'IDM Stub',
      serviceUrl: '/'
    }) }}

    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content" role="main">
        {% block content %}{% endblock %}
      </main>
    </div>

    {{ govukFooter() }}

    <script type="module">
      import { initAll } from '/assets/govuk/govuk-frontend.min.js'
      initAll()
    </script>
  </body>
</html>